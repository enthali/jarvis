
*.vsix
*.pyc

# Actor instructions — provisioned output, source of truth is packages/core/assets/
.github/instructions/*
# Project-owned process instruction (Admin)
!.github/instructions/contract-handling.instructions.md

# Actor agent bindings — Jarvis writes them from the actors folder at runtime
.github/agents/*

#environment files
.env
.venv/

# build artifacts
_build/
__pycache__/

#node modules and build artifacts
node_modules/
out/


# docs build artifacts
docs/_build/

# BEGIN JARVIS MANAGED (see jarvis.gitignore.autoManage)
.jarvis/logs/
.jarvis/messages/
.jarvis/state/
.jarvis/heartbeat.yaml
.jarvis/reminders.yaml
.jarvis/syspilot-state.json
jarvis-*
!packages/*/assets/**
# END JARVIS MANAGED

# Project ontology (Admin); listed after the managed block so it survives the jarvis-* rule
!docs/jarvis-ontology.toml

# testdata workspace runtime/scratch state (Dev Host manual testing,
# not automated-test fixtures - those live under testdata/heartbeat/)
testdata/.jarvis/messages/
testdata/.jarvis/heartbeat.yaml
testdata/.jarvis/state/
testdata/.jarvis/syspilot-state.json

# Extension Development Host isolated extensions (launch.json --extensions-dir)
.vscode-test/

# OS
Thumbs.db
.DS_Store

# Workspace (machine-specific)
#Jarvis.code-workspace

# testdata hook engine bridge files
testdata/.github/hooks/jarvis-*

# testdata test-environment VS Code settings
testdata/.vscode/settings.json

# Vitest compiled artifacts (vitest.config.ts is the source)
vitest.config.js
vitest.config.js.map
