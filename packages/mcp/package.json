{
  "name": "jarvis-mcp",
  "displayName": "Jarvis MCP",
  "description": "Jarvis MCP Server — exposes all registered Jarvis tools over MCP HTTP transport",
  "version": "0.26.0",
  "publisher": "enthali",
  "icon": "resources/jarvis-128.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./out/extension.js",
  "extensionDependencies": [
    "enthali.jarvis-core"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "node build.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile && npm run bundle"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jarvis-core": "*"
  },
  "contributes": {
    "configuration": [
      {
        "title": "Jarvis MCP",
        "properties": {
          "jarvis.mcp.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Start the embedded MCP server when the Jarvis MCP extension is active. Disable to keep the extension installed but the server off."
          },
          "jarvis.mcpPort": {
            "type": "number",
            "default": 31415,
            "description": "Port for the embedded MCP server."
          }
        }
      }
    ]
  }
}

