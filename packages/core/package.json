{
  "name": "jarvis-core",
  "displayName": "Jarvis Core",
  "description": "Jarvis core — sessions, messaging, reminders, heartbeat, engine",
  "version": "0.20.2",
  "publisher": "enthali",
  "icon": "resources/jarvis-128.png",
  "keywords": [
    "assistant",
    "productivity",
    "projects",
    "events",
    "sessions",
    "reminders",
    "heartbeat"
  ],
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enthali/Jarvis.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:jarvisMessages",
    "onView:jarvisReminders",
    "onView:jarvisHeartbeat",
    "onView:jarvisEntities"
  ],
  "main": "./out/extension.js",
  "types": "./out/engine/index.d.ts",
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "node build.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node build.js --minify"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "cron-parser": "^5.5.0",
    "js-yaml": "^4.1.1",
    "sql.js": "^1.14.1"
  },
  "contributes": {
    "yamlValidation": [
      {
        "fileMatch": "session.yaml",
        "url": "./schemas/session.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jarvis-explorer",
          "title": "Jarvis",
          "icon": "resources/jarvis.svg"
        }
      ]
    },
    "views": {
      "jarvis-explorer": [
        {
          "id": "jarvisEntities",
          "name": "Jarvis Entities"
        },
        {
          "id": "jarvisMessages",
          "name": "Messages",
          "when": "config.jarvis.messages.enabled == true"
        },
        {
          "id": "jarvisReminders",
          "name": "Reminders",
          "when": "config.jarvis.messages.enabled == true && config.jarvis.reminders.enabled == true"
        },
        {
          "id": "jarvisHeartbeat",
          "name": "Heartbeat",
          "when": "config.jarvis.heartbeat.enabled == true"
        }
      ]
    },
    "commands": [
      { "command": "jarvis.runHeartbeatJob", "title": "Jarvis: Run Heartbeat Job" },
      { "command": "jarvis.sendMessages", "title": "Jarvis: Send Messages to Chat Session", "icon": "$(debug-start)" },
      { "command": "jarvis.enableAutoDelivery", "title": "Enable Direct Delivery", "icon": "$(zap)" },
      { "command": "jarvis.disableAutoDelivery", "title": "Disable Direct Delivery", "icon": "$(zap)" },
      { "command": "jarvis.deleteMessage", "title": "Jarvis: Delete Queued Message", "icon": "$(trash)" },
      { "command": "jarvis.openSession", "title": "Jarvis: Open Chat Session" },
      { "command": "jarvis.openAgentSession", "title": "Jarvis: Open Chat", "icon": "$(comment-discussion)" },
      { "command": "jarvis.newEntity", "title": "Jarvis: New Entity", "icon": "$(add)" },
      { "command": "jarvis.newActor", "title": "Jarvis: New Actor", "icon": "$(add)" },
      { "command": "jarvis.migrateSessionToActor", "title": "Jarvis: Migrate Session to Actor" },
      { "command": "jarvis.searchEntities", "title": "Jarvis: Search Entities", "icon": "$(search)" },
      { "command": "jarvis.checkForUpdates", "title": "Jarvis: Check for Updates" },
      { "command": "jarvis.rescan", "title": "Jarvis: Rescan", "icon": "$(refresh)" },
      { "command": "jarvis.runJob", "title": "Jarvis: Run Job", "icon": "$(play)" },
      { "command": "jarvis.pauseHeartbeatJob", "title": "Jarvis: Pause Heartbeat Job", "icon": "$(debug-pause)" },
      { "command": "jarvis.resumeHeartbeatJob", "title": "Jarvis: Resume Heartbeat Job", "icon": "$(debug-continue)" },
      { "command": "jarvis.refreshHeartbeat", "title": "Jarvis: Refresh Heartbeat", "icon": "$(refresh)" },
      { "command": "jarvis.revealInExplorer", "title": "Reveal in Explorer" },
      { "command": "jarvis.revealInOS", "title": "Reveal in File Explorer" },
      { "command": "jarvis.openInTerminal", "title": "Open in Terminal" },
      { "command": "jarvis.openHeartbeatJob", "title": "Jarvis: Open Heartbeat Job" },
      { "command": "jarvis.openMessageFile", "title": "Jarvis: Open Message File" },
      { "command": "jarvis.openEntityFile", "title": "Jarvis: Open Entity File" },
      { "command": "jarvis.openReminderFile", "title": "Jarvis: Open Reminder File" },
      { "command": "jarvis.cancelReminder", "title": "Jarvis: Cancel Reminder", "icon": "$(trash)" },
      { "command": "jarvis.copyPath", "title": "Copy Path" },
      { "command": "jarvis.copyFullPath", "title": "Copy Full Path" },
      { "command": "jarvis.copyFileName", "title": "Copy File Name" },
      { "command": "jarvis.copyCategoryName", "title": "Copy" },
      { "command": "jarvis.openMessageSession", "title": "Jarvis: Open Message Session" },
      { "command": "jarvis.diffTouchedFile", "title": "Jarvis: Show Changes" },
      { "command": "jarvis.removeTouchedFile", "title": "Jarvis: Remove Touched File", "icon": "$(trash)" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "jarvis.openAgentSession", "when": "false" },
        { "command": "jarvis.newEntity", "when": "false" },
        { "command": "jarvis.newActor", "when": "false" },
        { "command": "jarvis.searchEntities", "when": "false" },
        { "command": "jarvis.rescan", "when": "false" },
        { "command": "jarvis.runJob", "when": "false" },
        { "command": "jarvis.pauseHeartbeatJob", "when": "false" },
        { "command": "jarvis.resumeHeartbeatJob", "when": "false" },
        { "command": "jarvis.refreshHeartbeat", "when": "false" },
        { "command": "jarvis.revealInExplorer", "when": "false" },
        { "command": "jarvis.revealInOS", "when": "false" },
        { "command": "jarvis.openInTerminal", "when": "false" },
        { "command": "jarvis.openHeartbeatJob", "when": "false" },
        { "command": "jarvis.openMessageFile", "when": "false" },
        { "command": "jarvis.openEntityFile", "when": "false" },
        { "command": "jarvis.openReminderFile", "when": "false" },
        { "command": "jarvis.enableAutoDelivery", "when": "false" },
        { "command": "jarvis.disableAutoDelivery", "when": "false" },
        { "command": "jarvis.cancelReminder", "when": "false" },
        { "command": "jarvis.copyPath", "when": "false" },
        { "command": "jarvis.copyFullPath", "when": "false" },
        { "command": "jarvis.copyFileName", "when": "false" },
        { "command": "jarvis.copyCategoryName", "when": "false" },
        { "command": "jarvis.openMessageSession", "when": "false" },
        { "command": "jarvis.diffTouchedFile", "when": "false" },
        { "command": "jarvis.removeTouchedFile", "when": "false" }
      ],
      "view/title": [
        { "command": "jarvis.searchEntities", "when": "view == jarvisEntities", "group": "navigation@1" },
        { "command": "jarvis.rescan", "when": "view == jarvisEntities", "group": "navigation@2" },
        { "command": "jarvis.refreshHeartbeat", "when": "view == jarvisHeartbeat", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "jarvis.newActor", "when": "viewItem == jarvisEntityCategory:session", "group": "inline" },
        { "command": "jarvis.sendMessages", "when": "viewItem == messageSession || viewItem == jarvisSessionManual || viewItem == jarvisSessionAutoDeliver", "group": "inline" },
        { "command": "jarvis.enableAutoDelivery", "when": "viewItem == jarvisSessionManual", "group": "inline" },
        { "command": "jarvis.disableAutoDelivery", "when": "viewItem == jarvisSessionAutoDeliver", "group": "inline" },
        { "command": "jarvis.deleteMessage", "when": "viewItem == messageItem", "group": "inline" },
        { "command": "jarvis.runJob", "when": "viewItem == heartbeatJob", "group": "inline" },
        { "command": "jarvis.runJob", "when": "viewItem == heartbeatJobPaused", "group": "inline" },
        { "command": "jarvis.pauseHeartbeatJob", "when": "viewItem == heartbeatJob", "group": "inline" },
        { "command": "jarvis.resumeHeartbeatJob", "when": "viewItem == heartbeatJobPaused", "group": "inline" },
        { "command": "jarvis.cancelReminder", "when": "viewItem == jarvisReminder", "group": "inline" },
        { "command": "jarvis.revealInExplorer", "when": "viewItem =~ /^jarvisSession$/", "group": "context-actions" },
        { "command": "jarvis.revealInOS", "when": "viewItem =~ /^jarvisSession$/", "group": "context-actions" },
        { "command": "jarvis.openInTerminal", "when": "viewItem =~ /^jarvisSession$/", "group": "context-actions" },
        { "command": "jarvis.openEntityFile", "when": "viewItem == jarvisEntityFile", "group": "open" },
        { "command": "jarvis.copyPath", "when": "viewItem == jarvisEntityFile", "group": "clipboard@1" },
        { "command": "jarvis.copyFullPath", "when": "viewItem == jarvisEntityFile", "group": "clipboard@2" },
        { "command": "jarvis.copyFileName", "when": "viewItem == jarvisEntityFile", "group": "clipboard@3" },
        { "command": "jarvis.openAgentSession", "when": "viewItem =~ /^jarvisSession$/", "group": "open" },
        { "command": "jarvis.copyPath", "when": "viewItem =~ /^jarvisSession$/", "group": "clipboard@1" },
        { "command": "jarvis.copyFullPath", "when": "viewItem =~ /^jarvisSession$/", "group": "clipboard@2" },
        { "command": "jarvis.copyCategoryName", "when": "viewItem == jarvisFolder", "group": "clipboard@1" },
        { "command": "jarvis.openEntityFile", "when": "viewItem == jarvisTouchedFile", "group": "open" },
        { "command": "jarvis.copyPath", "when": "viewItem == jarvisTouchedFile", "group": "clipboard@1" },
        { "command": "jarvis.copyFullPath", "when": "viewItem == jarvisTouchedFile", "group": "clipboard@2" },
        { "command": "jarvis.copyFileName", "when": "viewItem == jarvisTouchedFile", "group": "clipboard@3" },
        { "command": "jarvis.revealInExplorer", "when": "viewItem == jarvisTouchedFile", "group": "context-actions" },
        { "command": "jarvis.diffTouchedFile", "when": "viewItem == jarvisTouchedFile", "group": "diff" },
        { "command": "jarvis.removeTouchedFile", "when": "viewItem == jarvisTouchedFile", "group": "inline" }
      ]
    },
    "configuration": [
      {
        "title": "Actors",
        "properties": {
          "jarvis.sessions.enabled": { "type": "boolean", "default": true, "description": "Enable the Actors feature." }
        }
      },
      {
        "title": "Messages",
        "properties": {
          "jarvis.messages.enabled": { "type": "boolean", "default": true, "description": "Enable the Messages feature." },
          "jarvis.messages.logging": { "type": "boolean", "default": true, "description": "When enabled, every queued message is also appended to .jarvis/message-log.json." }
        }
      },
      {
        "title": "Prompt Templates",
        "properties": {
          "jarvis.agentSession.initPromptTemplate": {
            "type": "string",
            "default": "You are the agent session for the ${kind} \"${name}\".\n\nUse only `${contextPath}` as your persistent memory. Read it now.\n\nKeep it minimal and action-oriented:\n- Store only long-lived items under Decision / Finding / Next.\n- One concise line per bullet. Prune aggressively.\n- Replace outdated bullets — never append logs.\n- Never store retries, raw tool output, or transient chatter.\n- Before writing, ask: \"Will this still matter in 2 weeks?\" If no, skip.\n- When a topic grows past ~5 bullets, move it to a dedicated file beside `context.md` and leave a one-line summary with a relative link in `context.md`.",
            "editPresentation": "multilineText",
            "scope": "window",
            "description": "Template for the initialization prompt sent to a new agent chat session. Leave empty to use the built-in default."
          },
          "jarvis.messages.notificationTemplate": {
            "type": "string",
            "default": "[Jarvis Message Service] You have ${count} new message(s) in your inbox.\nRead them with the jarvis_readMessage tool (destination: \"${destination}\") until remaining = 0.",
            "editPresentation": "multilineText",
            "scope": "window",
            "description": "Template for the auto-delivery notification stub. Placeholders: ${count}, ${destination}, ${sender}. If empty, the built-in English default is used. Scope: window."
          }
        }
      },
      {
        "title": "Heartbeat",
        "properties": {
          "jarvis.heartbeat.enabled": { "type": "boolean", "default": true, "description": "Enable the Heartbeat scheduler." },
          "jarvis.heartbeatInterval": { "type": "number", "default": 60, "minimum": 10, "description": "Heartbeat scheduler tick interval in seconds." },
          "jarvis.scanInterval": { "type": "number", "default": 2, "minimum": 0, "description": "Background rescan interval in minutes (0 = disabled)." }
        }
      },
      {
        "title": "Reminders",
        "properties": {
          "jarvis.reminders.enabled": { "type": "boolean", "default": true, "description": "Enable the Reminders sub-feature." }
        }
      },

      {
        "title": "Updates",
        "properties": {
          "jarvis.checkForUpdates": { "type": "boolean", "default": true, "description": "Check for new Jarvis releases on GitHub when the extension activates." }
        }
      },
      {
        "title": "Hooks",
        "properties": {
          "jarvis.hooks.autoInstall": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "When true (default), Jarvis auto-installs hook bridge files in .github/hooks/. Set to false to remove managed files and stop hook management."
          }
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "jarvis_createActor",
        "displayName": "Create Actor",
        "modelDescription": "Creates a new Jarvis Actor folder with actor.yaml and context.md under <workspace>/.jarvis/actors/<name>/. Idempotent.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "createActor", "icon": "$(add)", "tags": ["jarvis"],
        "inputSchema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "summary": { "type": "string" }, "agent": { "type": "string" }, "initialMessage": { "type": "string" } } }
      },
      {
        "name": "jarvis_sendToSession",
        "displayName": "Send Message to Chat Session",
        "modelDescription": "[DEPRECATED AND DISABLED — use jarvis_sendMessage instead.] Queues a message for delivery to another VS Code chat session identified by name.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "sendToSession", "icon": "$(comment-discussion)",
        "inputSchema": { "type": "object", "required": ["session", "text"], "properties": { "session": { "type": "string" }, "senderSession": { "type": "string" }, "text": { "type": "string" } } }
      },
      {
        "name": "jarvis_sendMessage",
        "displayName": "Send Message",
        "modelDescription": "Queues a text message for delivery to a destination identified by name. Valid destinations are VS Code chat session tabs AND YAML entity names (sessions, projects, events). senderSession is required and validated against the same set — callers must pass their own session name explicitly. Fails immediately with an error if the destination or sender does not exist.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "sendMessage", "icon": "$(mail)",
        "inputSchema": { "type": "object", "required": ["session", "text", "senderSession"], "properties": { "session": { "type": "string", "description": "The exact name of the target (VS Code chat session title or YAML entity name)" }, "text": { "type": "string", "description": "The message text to queue" }, "senderSession": { "type": "string", "description": "Required: the exact name of the sending session — must not be omitted or inferred from the active tab" } } }
      },
      {
        "name": "jarvis_listActors",
        "displayName": "List Actors",
        "modelDescription": "Returns all Jarvis Actor entities (YAML-based) with name, summary, agent, and folder path.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "listActors", "icon": "$(list-unordered)",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "jarvis_listChatSessions",
        "displayName": "List Chat Sessions",
        "modelDescription": "Returns the list of named VS Code chat session titles in the current workspace.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "listChatSessions", "icon": "$(comment-discussion)",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "jarvis_readMessage",
        "displayName": "Read Message from Inbox",
        "modelDescription": "[DEPRECATED AND DISABLED — use jarvis_receiveMessage instead.] Reads and removes the oldest message from the Jarvis message queue for the given destination session.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "readMessage", "icon": "$(mail-read)",
        "inputSchema": { "type": "object", "required": ["destination"], "properties": { "destination": { "type": "string" } } }
      },
      {
        "name": "jarvis_receiveMessage",
        "displayName": "Receive Message from Inbox",
        "modelDescription": "Reads and removes the oldest message from the Jarvis inbox for the given destination session. Returns { message: { sender, text, timestamp } | null, remaining: number }. Call repeatedly until remaining === 0.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "receiveMessage", "icon": "$(mail-read)",
        "inputSchema": { "type": "object", "required": ["destination"], "properties": { "destination": { "type": "string", "description": "The exact name/title of the chat session whose inbox to read" } } }
      },
      {
        "name": "jarvis_registerJob",
        "displayName": "Register Heartbeat Job",
        "modelDescription": "Registers (or updates) a heartbeat job.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "registerJob", "icon": "$(add)",
        "inputSchema": { "type": "object", "required": ["name", "schedule", "steps"], "properties": { "name": { "type": "string" }, "schedule": { "type": "string" }, "steps": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" }, "run": { "type": "string" }, "prompt": { "type": "string" }, "outputFile": { "type": "string" }, "append": { "type": "boolean" }, "destination": { "type": "string" }, "sender": { "type": "string" }, "text": { "type": "string" } } } } } }
      },
      {
        "name": "jarvis_unregisterJob",
        "displayName": "Unregister Heartbeat Job",
        "modelDescription": "Removes a heartbeat job by name.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "unregisterJob", "icon": "$(trash)",
        "inputSchema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
      },
      {
        "name": "jarvis_listJobs",
        "displayName": "List Heartbeat Jobs",
        "modelDescription": "Returns all registered heartbeat jobs.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "listJobs", "icon": "$(list-unordered)",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "jarvis_setReminder",
        "displayName": "Set Reminder",
        "modelDescription": "Registers a time-scheduled reminder.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "setReminder", "icon": "$(bell)",
        "inputSchema": { "type": "object", "required": ["text", "session", "deliverAt"], "properties": { "text": { "type": "string" }, "session": { "type": "string" }, "deliverAt": { "type": "string" } } }
      },
      {
        "name": "jarvis_listReminders",
        "displayName": "List Reminders",
        "modelDescription": "Returns all pending reminders.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "listReminders", "icon": "$(bell)",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "jarvis_cancelReminder",
        "displayName": "Cancel Reminder",
        "modelDescription": "Cancels a pending reminder by id.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "cancelReminder", "icon": "$(bell-slash)",
        "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } }
      }
    ]
  }
}

