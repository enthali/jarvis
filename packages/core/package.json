{
  "name": "jarvis-core",
  "displayName": "Jarvis Core",
  "description": "Jarvis core — sessions, messaging, reminders, heartbeat, engine",
  "version": "0.32.0",
  "publisher": "enthali",
  "icon": "resources/jarvis-128.png",
  "keywords": [
    "assistant",
    "productivity",
    "projects",
    "events",
    "sessions",
    "reminders",
    "heartbeat"
  ],
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enthali/Jarvis.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:jarvisMessages",
    "onView:jarvisReminders",
    "onView:jarvisHeartbeat",
    "onView:jarvisActors"
  ],
  "main": "./out/extension.js",
  "types": "./out/engine/index.d.ts",
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "node build.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node build.js --minify"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "cron-parser": "^5.5.0",
    "js-yaml": "^4.1.1",
    "sql.js": "^1.14.1",
    "ws": "^8.22.0"
  },
  "capabilities": {
    "agentsWindow": {
      "supported": true
    }
  },
  "contributes": {
    "yamlValidation": [
      {
        "fileMatch": "actor.yaml",
        "url": "./schemas/actor.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jarvis-explorer",
          "title": "Jarvis",
          "icon": "resources/jarvis.svg"
        }
      ]
    },
    "views": {
      "jarvis-explorer": [
        {
          "id": "jarvisActors",
          "name": "Actors"
        },
        {
          "id": "jarvisMessages",
          "name": "Messages",
          "when": "config.jarvis.messages.enabled == true"
        },
        {
          "id": "jarvisReminders",
          "name": "Reminders",
          "when": "config.jarvis.messages.enabled == true && config.jarvis.reminders.enabled == true"
        },
        {
          "id": "jarvisHeartbeat",
          "name": "Heartbeat",
          "when": "config.jarvis.heartbeat.enabled == true"
        }
      ]
    },
    "commands": [
      { "command": "jarvis.runHeartbeatJob", "title": "Jarvis: Run Heartbeat Job" },
      { "command": "jarvis.sendMessages", "title": "Jarvis: Send Messages to Chat Session", "icon": "$(debug-start)" },
      { "command": "jarvis.enableAutoDelivery", "title": "Enable Direct Delivery", "icon": "$(zap)" },
      { "command": "jarvis.disableAutoDelivery", "title": "Disable Direct Delivery", "icon": "$(zap)" },
      { "command": "jarvis.deleteMessage", "title": "Jarvis: Delete Queued Message", "icon": "$(trash)" },
      { "command": "jarvis.openActorSession", "title": "Open" },
      { "command": "jarvis.newActor", "title": "Jarvis: New Actor", "icon": "$(add)" },
      { "command": "jarvis.checkForUpdates", "title": "Jarvis: Check for Updates" },
      { "command": "jarvis.showReleaseNotes", "title": "Jarvis: Show Release Notes" },
      { "command": "jarvis.rescan", "title": "Jarvis: Rescan", "icon": "$(refresh)" },
      { "command": "jarvis.runJob", "title": "Jarvis: Run Job", "icon": "$(play)" },
      { "command": "jarvis.listModels", "title": "Jarvis: List Language Models" },
      { "command": "jarvis.pauseHeartbeatJob", "title": "Jarvis: Pause Heartbeat Job", "icon": "$(debug-pause)" },
      { "command": "jarvis.resumeHeartbeatJob", "title": "Jarvis: Resume Heartbeat Job", "icon": "$(debug-continue)" },
      { "command": "jarvis.refreshHeartbeat", "title": "Jarvis: Refresh Heartbeat", "icon": "$(refresh)" },
      { "command": "jarvis.revealInExplorer", "title": "Reveal in Explorer" },
      { "command": "jarvis.revealInOS", "title": "Reveal in File Explorer" },
      { "command": "jarvis.openInTerminal", "title": "Open in Terminal" },
      { "command": "jarvis.openHeartbeatJob", "title": "Jarvis: Open Heartbeat Job" },
      { "command": "jarvis.openMessageFile", "title": "Jarvis: Open Message File" },
      { "command": "jarvis.openActorFile", "title": "Jarvis: Open Actor File" },
      { "command": "jarvis.openReminderFile", "title": "Jarvis: Open Reminder File" },
      { "command": "jarvis.cancelReminder", "title": "Jarvis: Cancel Reminder", "icon": "$(trash)" },
      { "command": "jarvis.copyPath", "title": "Copy Path" },
      { "command": "jarvis.copyFullPath", "title": "Copy Full Path" },
      { "command": "jarvis.copyFileName", "title": "Copy File Name" },
      { "command": "jarvis.openMessageActorChat", "title": "Jarvis: Open Actor Chat" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "jarvis.openActorSession", "when": "false" },
        { "command": "jarvis.newActor", "when": "false" },
        { "command": "jarvis.rescan", "when": "false" },
        { "command": "jarvis.runJob", "when": "false" },
        { "command": "jarvis.pauseHeartbeatJob", "when": "false" },
        { "command": "jarvis.resumeHeartbeatJob", "when": "false" },
        { "command": "jarvis.refreshHeartbeat", "when": "false" },
        { "command": "jarvis.revealInExplorer", "when": "false" },
        { "command": "jarvis.revealInOS", "when": "false" },
        { "command": "jarvis.openInTerminal", "when": "false" },
        { "command": "jarvis.openHeartbeatJob", "when": "false" },
        { "command": "jarvis.openMessageFile", "when": "false" },
        { "command": "jarvis.openActorFile", "when": "false" },
        { "command": "jarvis.openReminderFile", "when": "false" },
        { "command": "jarvis.enableAutoDelivery", "when": "false" },
        { "command": "jarvis.disableAutoDelivery", "when": "false" },
        { "command": "jarvis.cancelReminder", "when": "false" },
        { "command": "jarvis.copyPath", "when": "false" },
        { "command": "jarvis.copyFullPath", "when": "false" },
        { "command": "jarvis.copyFileName", "when": "false" },
        { "command": "jarvis.openMessageActorChat", "when": "false" }
      ],
      "view/title": [
        { "command": "jarvis.newActor", "when": "view == jarvisActors", "group": "navigation@1" },
        { "command": "jarvis.rescan", "when": "view == jarvisActors", "group": "navigation@2" },
        { "command": "jarvis.refreshHeartbeat", "when": "view == jarvisHeartbeat", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "jarvis.sendMessages", "when": "viewItem == messageSession || viewItem == jarvisSessionManual || viewItem == jarvisSessionAutoDeliver", "group": "inline" },
        { "command": "jarvis.enableAutoDelivery", "when": "viewItem == jarvisSessionManual", "group": "inline" },
        { "command": "jarvis.disableAutoDelivery", "when": "viewItem == jarvisSessionAutoDeliver", "group": "inline" },
        { "command": "jarvis.deleteMessage", "when": "viewItem == messageItem", "group": "inline" },
        { "command": "jarvis.runJob", "when": "viewItem == heartbeatJob", "group": "inline" },
        { "command": "jarvis.runJob", "when": "viewItem == heartbeatJobPaused", "group": "inline" },
        { "command": "jarvis.pauseHeartbeatJob", "when": "viewItem == heartbeatJob", "group": "inline" },
        { "command": "jarvis.resumeHeartbeatJob", "when": "viewItem == heartbeatJobPaused", "group": "inline" },
        { "command": "jarvis.cancelReminder", "when": "viewItem == jarvisReminder", "group": "inline" },
        { "command": "jarvis.openActorSession", "when": "viewItem == jarvisActor", "group": "open" },
        { "command": "jarvis.revealInExplorer", "when": "viewItem == jarvisActor", "group": "context-actions" },
        { "command": "jarvis.revealInOS", "when": "viewItem == jarvisActor", "group": "context-actions" },
        { "command": "jarvis.openInTerminal", "when": "viewItem == jarvisActor", "group": "context-actions" },
        { "command": "jarvis.copyPath", "when": "viewItem == jarvisActor", "group": "clipboard@1" },
        { "command": "jarvis.copyFullPath", "when": "viewItem == jarvisActor", "group": "clipboard@2" },
        { "command": "jarvis.openActorFile", "when": "viewItem == jarvisActorFile", "group": "open" },
        { "command": "jarvis.copyPath", "when": "viewItem == jarvisActorFile", "group": "clipboard@1" },
        { "command": "jarvis.copyFullPath", "when": "viewItem == jarvisActorFile", "group": "clipboard@2" },
        { "command": "jarvis.copyFileName", "when": "viewItem == jarvisActorFile", "group": "clipboard@3" }
      ]
    },
    "configuration": [
      {
        "title": "Actors",
        "properties": {
          "jarvis.actors.folder": {
            "type": "string",
            "default": ".jarvis/actors",
            "description": "Workspace-relative or absolute folder containing new Actor folders."
          },
          "jarvis.actors.openSessionOnCreate": {
            "type": "boolean",
            "default": true,
            "description": "Open the new Actor's chat right after creating it. Turn off to keep your current chat in focus, e.g. when creating several Actors in a row."
          },
          "jarvis.actor.autoProvision": {
            "type": "boolean",
            "default": true,
            "description": "Automatically provision bundled actor instruction files into the workspace on activation. Default true — set to false in workspaces that do not use Jarvis actors to remove them."
          }
        }
      },
      {
        "title": "Messages",
        "properties": {
          "jarvis.messages.enabled": { "type": "boolean", "default": true, "description": "Enable the Messages feature." },
          "jarvis.messages.logging": { "type": "boolean", "default": true, "description": "When enabled, every queued message is also appended to .jarvis/message-log.json." }
        }
      },
      {
        "title": "Prompt Templates",
        "properties": {
          "jarvis.agentSession.initPromptTemplate": {
            "type": "string",
            "default": "You are the Actor \"${name}\".\n\nUse only `${contextPath}` as your persistent memory. Read it now.\n\nKeep it minimal and action-oriented:\n- Store only long-lived items under Decision / Finding / Next.\n- One concise line per bullet. Prune aggressively.\n- Replace outdated bullets — never append logs.\n- Never store retries, raw tool output, or transient chatter.\n- Before writing, ask: \"Will this still matter in 2 weeks?\" If no, skip.\n- When a topic grows past ~5 bullets, move it to a dedicated file beside `context.md` and leave a one-line summary with a relative link in `context.md`.",
            "editPresentation": "multilineText",
            "scope": "window",
            "description": "Template for the initialization prompt sent to a new agent chat session. Leave empty to use the built-in default."
          }
        }
      },
      {
        "title": "Heartbeat",
        "properties": {
          "jarvis.heartbeat.enabled": { "type": "boolean", "default": true, "description": "Enable the Heartbeat scheduler." },
          "jarvis.heartbeatInterval": { "type": "number", "default": 60, "minimum": 10, "description": "Heartbeat scheduler tick interval in seconds." },
          "jarvis.scanInterval": { "type": "number", "default": 2, "minimum": 0, "description": "Background rescan interval in minutes (0 = disabled)." }
        }
      },
      {
        "title": "Reminders",
        "properties": {
          "jarvis.reminders.enabled": { "type": "boolean", "default": true, "description": "Enable the Reminders sub-feature." }
        }
      },
      {
        "title": "Gitignore",
        "properties": {
          "jarvis.gitignore.autoManage": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "When true (default), Jarvis maintains a marked region in the workspace .gitignore listing its transient runtime paths. Set to false to remove the region."
          }
        }
      },
      {
        "title": "Updates",
        "properties": {
          "jarvis.checkForUpdates": { "type": "boolean", "default": true, "description": "Check for new Jarvis releases on GitHub when the extension activates." },
          "jarvis.releaseNotes.showOnUpdate": { "type": "boolean", "default": true, "scope": "application", "description": "Open the release notes in the editor the first time a newly installed Jarvis version runs. The command \"Jarvis: Show Release Notes\" works regardless of this setting." }
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "jarvis_createActor",
        "displayName": "Create Actor",
        "modelDescription": "jarvis_core: Creates a new Jarvis Actor folder with actor.yaml and context.md under <workspace>/.jarvis/actors/<name>/. Idempotent.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "jarvis_core_createActor", "icon": "$(add)", "tags": ["jarvis"],
        "inputSchema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "summary": { "type": "string" }, "initialMessage": { "type": "string" } } }
      },
      {
        "name": "jarvis_registerJob",
        "displayName": "Register Heartbeat Job",
        "modelDescription": "jarvis_core: Registers (or updates) a heartbeat job.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "jarvis_core_registerJob", "icon": "$(add)",
        "inputSchema": { "type": "object", "required": ["name", "schedule", "steps"], "properties": { "name": { "type": "string" }, "schedule": { "type": "string" }, "steps": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" }, "run": { "type": "string" }, "prompt": { "type": "string" }, "outputFile": { "type": "string" }, "append": { "type": "boolean" }, "vendor": { "type": "string", "description": "Agent step: vendor of the language model, exactly as returned by jarvis_listModels." }, "model": { "type": "string", "description": "Agent step: model id, exactly as returned by jarvis_listModels." }, "destination": { "type": "string" }, "sender": { "type": "string" }, "text": { "type": "string" } } } } } }
      },
      {
        "name": "jarvis_unregisterJob",
        "displayName": "Unregister Heartbeat Job",
        "modelDescription": "jarvis_core: Removes a heartbeat job by name.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "jarvis_core_unregisterJob", "icon": "$(trash)",
        "inputSchema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
      },
      {
        "name": "jarvis_listJobs",
        "displayName": "List Heartbeat Jobs",
        "modelDescription": "jarvis_core: Returns all registered heartbeat jobs.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "jarvis_core_listJobs", "icon": "$(list-unordered)",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "jarvis_listModels",
        "displayName": "List Language Models",
        "modelDescription": "jarvis_core: Returns the language models an agent step of a heartbeat job can name, as an array of { vendor, model }. Use vendor and model exactly as returned.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "jarvis_core_listModels", "icon": "$(list-unordered)",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "jarvis_setReminder",
        "displayName": "Set Reminder",
        "modelDescription": "jarvis_core: Registers a time-scheduled reminder.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "jarvis_core_setReminder", "icon": "$(bell)",
        "inputSchema": { "type": "object", "required": ["text", "session", "deliverAt"], "properties": { "text": { "type": "string" }, "session": { "type": "string" }, "deliverAt": { "type": "string" } } }
      },
      {
        "name": "jarvis_listReminders",
        "displayName": "List Reminders",
        "modelDescription": "jarvis_core: Returns all pending reminders.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "jarvis_core_listReminders", "icon": "$(bell)",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "jarvis_cancelReminder",
        "displayName": "Cancel Reminder",
        "modelDescription": "jarvis_core: Cancels a pending reminder by id.",
        "canBeReferencedInPrompt": true, "toolReferenceName": "jarvis_core_cancelReminder", "icon": "$(bell-slash)",
        "inputSchema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } }
      }
    ]
  }
}

