{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "noEmit": true,
    "lib": ["ES2022"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "."
  },
  "include": ["src/apps/**"],
  "exclude": ["node_modules", ".vscode-test", "packages"]
}
