{
  "name": "jarvis",
  "displayName": "Jarvis",
  "description": "Personal assistant for managing projects and events in VS Code",
  "version": "0.6.1",
  "publisher": "enthali",
  "repository": {
    "type": "git",
    "url": "https://github.com/enthali/Jarvis.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:jarvisProjects",
    "onView:jarvisEvents",
    "onView:jarvisMessages",
    "onView:jarvisReminders",
    "onView:jarvisHeartbeat",
    "onView:jarvisCategories",
    "onView:jarvisSessions"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "yamlValidation": [
      { "fileMatch": "session.yaml", "url": "./schemas/session.schema.json" }
    ],
    "customEditors": [
      {
        "viewType": "jarvis.taskEditor",
        "displayName": "Jarvis Task Editor",
        "selector": [
          { "filenamePattern": "*.jarvis-task" }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jarvis-explorer",
          "title": "Jarvis",
          "icon": "resources/jarvis.svg"
        }
      ]
    },
    "views": {
      "jarvis-explorer": [
        {
          "id": "jarvisProjects",
          "name": "Projects",
          "when": "config.jarvis.projects.enabled == true"
        },
        {
          "id": "jarvisSessions",
          "name": "Sessions",
          "when": "config.jarvis.sessions.enabled == true"
        },
        {
          "id": "jarvisEvents",
          "name": "Events",
          "when": "config.jarvis.events.enabled == true"
        },
        {
          "id": "jarvisMessages",
          "name": "Messages",
          "when": "config.jarvis.messages.enabled == true"
        },
        {
          "id": "jarvisReminders",
          "name": "Reminders",
          "when": "config.jarvis.messages.enabled == true && config.jarvis.reminders.enabled == true"
        },
        {
          "id": "jarvisHeartbeat",
          "name": "Heartbeat",
          "when": "config.jarvis.heartbeat.enabled == true"
        },
        {
          "id": "jarvisCategories",
          "name": "Categories",
          "when": "config.jarvis.pim.showCategories == true && config.jarvis.outlook.enabled == true"
        }
      ]
    },
    "commands": [
      {
        "command": "jarvis.filterProjectFolders",
        "title": "Filter Project Folders",
        "icon": "$(filter)"
      },
      {
        "command": "jarvis.filterProjectFoldersActive",
        "title": "Filter Project Folders",
        "icon": "$(filter-filled)"
      },
      {
        "command": "jarvis.filterFutureEvents",
        "title": "Show Future Events Only",
        "icon": "$(filter)"
      },
      {
        "command": "jarvis.filterFutureEventsActive",
        "title": "Show Future Events Only",
        "icon": "$(filter-filled)"
      },
      {
        "command": "jarvis.openYamlFile",
        "title": "Open YAML File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jarvis.runHeartbeatJob",
        "title": "Jarvis: Run Heartbeat Job"
      },
      {
        "command": "jarvis.sendMessages",
        "title": "Jarvis: Send Messages to Chat Session",
        "icon": "$(debug-start)"
      },
      {
        "command": "jarvis.enableAutoDelivery",
        "title": "Enable Direct Delivery",
        "icon": "$(zap)"
      },
      {
        "command": "jarvis.disableAutoDelivery",
        "title": "Disable Direct Delivery",
        "icon": "$(zap)"
      },
      {
        "command": "jarvis.deleteMessage",
        "title": "Jarvis: Delete Queued Message",
        "icon": "$(trash)"
      },
      {
        "command": "jarvis.openSession",
        "title": "Jarvis: Open Chat Session"
      },
      {
        "command": "jarvis.openAgentSession",
        "title": "Jarvis: Open Agent Session",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "jarvis.openContext",
        "title": "Jarvis: Open Context",
        "icon": "$(notebook)"
      },
      {
        "command": "jarvis.newProject",
        "title": "Jarvis: New Project",
        "icon": "$(add)"
      },
      {
        "command": "jarvis.newEvent",
        "title": "Jarvis: New Event",
        "icon": "$(add)"
      },
      {
        "command": "jarvis.newEntity",
        "title": "Jarvis: New Entity",
        "icon": "$(add)"
      },
      {
        "command": "jarvis.newSession",
        "title": "Jarvis: New Session",
        "icon": "$(add)"
      },
      {
        "command": "jarvis.checkForUpdates",
        "title": "Jarvis: Check for Updates"
      },
      {
        "command": "jarvis.rescan",
        "title": "Jarvis: Rescan",
        "icon": "$(refresh)"
      },
      {
        "command": "jarvis.runJob",
        "title": "Jarvis: Run Job",
        "icon": "$(play)"
      },
      {
        "command": "jarvis.pauseHeartbeatJob",
        "title": "Jarvis: Pause Heartbeat Job",
        "icon": "$(debug-pause)"
      },
      {
        "command": "jarvis.resumeHeartbeatJob",
        "title": "Jarvis: Resume Heartbeat Job",
        "icon": "$(debug-continue)"
      },
      {
        "command": "jarvis.refreshHeartbeat",
        "title": "Jarvis: Refresh Heartbeat",
        "icon": "$(refresh)"
      },
      {
        "command": "jarvis.revealInExplorer",
        "title": "Reveal in Explorer"
      },
      {
        "command": "jarvis.revealInOS",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "jarvis.openInTerminal",
        "title": "Open in Terminal"
      },
      {
        "command": "jarvis.refreshCategories",
        "title": "Jarvis: Refresh Categories",
        "icon": "$(refresh)"
      },
      {
        "command": "jarvis.renameCategory",
        "title": "Jarvis: Rename Category"
      },
      {
        "command": "jarvis.deleteCategory",
        "title": "Jarvis: Delete Category"
      },
      {
        "command": "jarvis.refreshTasks",
        "title": "Jarvis: Refresh Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "jarvis.startRecording",
        "title": "Start Recording",
        "icon": "$(circle-outline)"
      },
      {
        "command": "jarvis.stopRecording",
        "title": "Stop Recording",
        "icon": "$(circle-filled)"
      },
      {
        "command": "jarvis.openHeartbeatJob",
        "title": "Jarvis: Open Heartbeat Job"
      },
      {
        "command": "jarvis.openMessageFile",
        "title": "Jarvis: Open Message File"
      },
      {
        "command": "jarvis.openReminderFile",
        "title": "Jarvis: Open Reminder File"
      },
      {
        "command": "jarvis.searchProjects",
        "title": "Search Projects",
        "icon": "$(search)"
      },
      {
        "command": "jarvis.searchEvents",
        "title": "Search Events",
        "icon": "$(search)"
      },
      {
        "command": "jarvis.cancelReminder",
        "title": "Jarvis: Cancel Reminder",
        "icon": "$(trash)"
      },
      {
        "command": "jarvis.openSessionContext",
        "title": "Jarvis: Open Session Context",
        "shortTitle": "Open context.md",
        "icon": "$(book)",
        "category": "Jarvis"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jarvis.openSessionContext",
          "when": "false"
        },
        {
          "command": "jarvis.openAgentSession",
          "when": "false"
        },
        {
          "command": "jarvis.openContext",
          "when": "false"
        },
        {
          "command": "jarvis.newProject",
          "when": "false"
        },
        {
          "command": "jarvis.newEvent",
          "when": "false"
        },
        {
          "command": "jarvis.newEntity",
          "when": "false"
        },
        {
          "command": "jarvis.newSession",
          "when": "false"
        },
        {
          "command": "jarvis.rescan",
          "when": "false"
        },
        {
          "command": "jarvis.runJob",
          "when": "false"
        },
        {
          "command": "jarvis.pauseHeartbeatJob",
          "when": "false"
        },
        {
          "command": "jarvis.resumeHeartbeatJob",
          "when": "false"
        },
        {
          "command": "jarvis.refreshHeartbeat",
          "when": "false"
        },
        {
          "command": "jarvis.refreshCategories",
          "when": "false"
        },
        {
          "command": "jarvis.renameCategory",
          "when": "false"
        },
        {
          "command": "jarvis.deleteCategory",
          "when": "false"
        },
        {
          "command": "jarvis.refreshTasks",
          "when": "false"
        },
        {
          "command": "jarvis.startRecording",
          "when": "false"
        },
        {
          "command": "jarvis.stopRecording",
          "when": "false"
        },
        {
          "command": "jarvis.revealInExplorer",
          "when": "false"
        },
        {
          "command": "jarvis.revealInOS",
          "when": "false"
        },
        {
          "command": "jarvis.openInTerminal",
          "when": "false"
        },
        {
          "command": "jarvis.openHeartbeatJob",
          "when": "false"
        },
        {
          "command": "jarvis.openMessageFile",
          "when": "false"
        },
        {
          "command": "jarvis.openReminderFile",
          "when": "false"
        },
        {
          "command": "jarvis.searchProjects",
          "when": "false"
        },
        {
          "command": "jarvis.searchEvents",
          "when": "false"
        },
        {
          "command": "jarvis.enableAutoDelivery",
          "when": "false"
        },
        {
          "command": "jarvis.disableAutoDelivery",
          "when": "false"
        },
        {
          "command": "jarvis.cancelReminder",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "jarvis.newProject",
          "when": "view == jarvisProjects",
          "group": "navigation@1"
        },
        {
          "command": "jarvis.filterProjectFolders",
          "when": "view == jarvisProjects && !jarvis.projectFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "jarvis.filterProjectFoldersActive",
          "when": "view == jarvisProjects && jarvis.projectFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "jarvis.rescan",
          "when": "view == jarvisProjects",
          "group": "navigation@3"
        },
        {
          "command": "jarvis.searchProjects",
          "when": "view == jarvisProjects",
          "group": "navigation"
        },
        {
          "command": "jarvis.newEvent",
          "when": "view == jarvisEvents",
          "group": "navigation@1"
        },
        {
          "command": "jarvis.filterFutureEvents",
          "when": "view == jarvisEvents && !jarvis.eventFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "jarvis.filterFutureEventsActive",
          "when": "view == jarvisEvents && jarvis.eventFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "jarvis.rescan",
          "when": "view == jarvisEvents",
          "group": "navigation@3"
        },
        {
          "command": "jarvis.searchEvents",
          "when": "view == jarvisEvents",
          "group": "navigation"
        },
        {
          "command": "jarvis.newSession",
          "when": "view == jarvisSessions",
          "group": "navigation@1"
        },
        {
          "command": "jarvis.rescan",
          "when": "view == jarvisSessions",
          "group": "navigation@3"
        },
        {
          "command": "jarvis.refreshHeartbeat",
          "when": "view == jarvisHeartbeat",
          "group": "navigation@1"
        },
        {
          "command": "jarvis.refreshCategories",
          "when": "view == jarvisCategories",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "jarvis.openSessionContext",
          "when": "view == jarvisSessions && viewItem == jarvisSession",
          "group": "inline"
        },
        {
          "command": "jarvis.openYamlFile",
          "when": "viewItem == jarvisProject",
          "group": "inline"
        },
        {
          "command": "jarvis.openYamlFile",
          "when": "viewItem == jarvisEvent",
          "group": "inline"
        },
        {
          "command": "jarvis.sendMessages",
          "when": "viewItem == messageSession || viewItem == jarvisSessionManual || viewItem == jarvisSessionAutoDeliver",
          "group": "inline"
        },
        {
          "command": "jarvis.enableAutoDelivery",
          "when": "viewItem == jarvisSessionManual",
          "group": "inline"
        },
        {
          "command": "jarvis.disableAutoDelivery",
          "when": "viewItem == jarvisSessionAutoDeliver",
          "group": "inline"
        },
        {
          "command": "jarvis.deleteMessage",
          "when": "viewItem == messageItem",
          "group": "inline"
        },
        {
          "command": "jarvis.openAgentSession",
          "when": "viewItem == jarvisProject",
          "group": "inline"
        },
        {
          "command": "jarvis.openAgentSession",
          "when": "viewItem == jarvisEvent",
          "group": "inline"
        },
        {
          "command": "jarvis.openContext",
          "when": "viewItem == jarvisProject",
          "group": "inline"
        },
        {
          "command": "jarvis.openContext",
          "when": "viewItem == jarvisEvent",
          "group": "inline"
        },
        {
          "command": "jarvis.openContext",
          "when": "viewItem == jarvisSession"
        },
        {
          "command": "jarvis.openAgentSession",
          "when": "viewItem == jarvisSession"
        },
        {
          "command": "jarvis.runJob",
          "when": "viewItem == heartbeatJob",
          "group": "inline"
        },
        {
          "command": "jarvis.runJob",
          "when": "viewItem == heartbeatJobPaused",
          "group": "inline"
        },
        {
          "command": "jarvis.pauseHeartbeatJob",
          "when": "viewItem == heartbeatJob",
          "group": "inline"
        },
        {
          "command": "jarvis.resumeHeartbeatJob",
          "when": "viewItem == heartbeatJobPaused",
          "group": "inline"
        },
        {
          "command": "jarvis.cancelReminder",
          "when": "viewItem == jarvisReminder",
          "group": "inline"
        },
        {
          "command": "jarvis.revealInExplorer",
          "when": "viewItem == jarvisProject",
          "group": "context-actions"
        },
        {
          "command": "jarvis.revealInExplorer",
          "when": "viewItem == jarvisEvent",
          "group": "context-actions"
        },
        {
          "command": "jarvis.revealInExplorer",
          "when": "viewItem == jarvisSession",
          "group": "context-actions"
        },
        {
          "command": "jarvis.revealInOS",
          "when": "viewItem == jarvisProject",
          "group": "context-actions"
        },
        {
          "command": "jarvis.revealInOS",
          "when": "viewItem == jarvisEvent",
          "group": "context-actions"
        },
        {
          "command": "jarvis.revealInOS",
          "when": "viewItem == jarvisSession",
          "group": "context-actions"
        },
        {
          "command": "jarvis.openInTerminal",
          "when": "viewItem == jarvisProject",
          "group": "context-actions"
        },
        {
          "command": "jarvis.openInTerminal",
          "when": "viewItem == jarvisEvent",
          "group": "context-actions"
        },
        {
          "command": "jarvis.openInTerminal",
          "when": "viewItem == jarvisSession",
          "group": "context-actions"
        },
        {
          "command": "jarvis.renameCategory",
          "when": "viewItem == jarvisCategory",
          "group": "inline"
        },
        {
          "command": "jarvis.deleteCategory",
          "when": "viewItem == jarvisCategory"
        },
        {
          "command": "jarvis.startRecording",
          "when": "viewItem == jarvisProject && config.jarvis.recording.enabled == true && jarvis.recordingActive != true",
          "group": "inline"
        },
        {
          "command": "jarvis.stopRecording",
          "when": "viewItem == jarvisProject && config.jarvis.recording.enabled == true && jarvis.recordingActive == true",
          "group": "inline"
        },
        {
          "command": "jarvis.startRecording",
          "when": "viewItem == jarvisEvent && config.jarvis.recording.enabled == true && jarvis.recordingActive != true",
          "group": "inline"
        },
        {
          "command": "jarvis.stopRecording",
          "when": "viewItem == jarvisEvent && config.jarvis.recording.enabled == true && jarvis.recordingActive == true",
          "group": "inline"
        }
      ]
    },
    "configuration": [
      {
        "title": "Projects",
        "properties": {
          "jarvis.projects.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable the Projects feature. When false, no Projects tree view, commands, or tools are registered."
          },
          "jarvis.projects.folder": {
            "type": "string",
            "default": "",
            "description": "Absolute path to the folder containing project YAML files."
          },
          "jarvis.scanInterval": {
            "type": "number",
            "default": 2,
            "minimum": 0,
            "description": "Background rescan interval in minutes (0 = disabled, registers via heartbeat)."
          }
        }
      },
      {
        "title": "Events",
        "properties": {
          "jarvis.events.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable the Events feature. When false, no Events tree view, commands, or tools are registered."
          },
          "jarvis.events.folder": {
            "type": "string",
            "default": "",
            "description": "Absolute path to the folder containing event YAML files."
          }
        }
      },
      {
        "title": "Sessions",
        "properties": {
          "jarvis.sessions.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the Sessions feature (lightweight project entities)."
          },
          "jarvis.agentSession.initPromptTemplate": {
            "type": "string",
            "default": "You are the ${kind} \"${name}\".\n\nUse only `${contextPath}` as your persistent memory. Read it now.\n\nKeep it minimal and action-oriented:\n- Store only long-lived items under Decision / Finding / Next.\n- One concise line per bullet. Prune aggressively.\n- Replace outdated bullets — never append logs.\n- Never store retries, raw tool output, or transient chatter.\n- Before writing, ask: \"Will this still matter in 2 weeks?\" If no, skip.",
            "editPresentation": "multilineText",
            "scope": "window",
            "description": "Template for the initialization prompt sent to a new agent chat session. Placeholders: ${kind} (entity kind), ${name} (entity name), ${contextPath} (absolute path to context.md). Leave empty to use the built-in disciplined default.",
            "markdownDescription": "Template for the initialization prompt sent to a new agent chat session.\n\nPlaceholders: `${kind}`, `${name}`, `${contextPath}` (absolute path to `context.md`).\n\nLeave empty or whitespace-only to use the built-in disciplined default."
          }
        }
      },
      {
        "title": "Messages",
        "properties": {
          "jarvis.messages.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the Messages feature. When false, no Messages tree view, commands, or tools are registered."
          },
          "jarvis.messages.logging": {
            "type": "boolean",
            "default": true,
            "description": "When enabled, every queued message is also appended to .jarvis/message-log.json (append-only audit log)."
          },
          "jarvis.messages.notificationTemplate": {
            "type": "string",
            "default": "[Jarvis Message Service] You have ${count} new message(s) in your inbox.\nRead them with the jarvis_readMessage tool (destination: \"${destination}\") until remaining = 0.",
            "editPresentation": "multilineText",
            "scope": "window",
            "description": "Template for the auto-delivery notification sent to an agent session. Placeholders: ${count} (number of pending messages), ${destination} (target session name). Leave empty to use the built-in English default."
          }
        }
      },
      {
        "title": "Heartbeat",
        "properties": {
          "jarvis.heartbeat.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the Heartbeat scheduler. When false, no Heartbeat tree view, scheduler, or tools are registered."
          },
          "jarvis.heartbeatInterval": {
            "type": "number",
            "default": 60,
            "minimum": 10,
            "description": "Heartbeat scheduler tick interval in seconds (minimum 10)."
          }
        }
      },
      {
        "title": "Reminders",
        "properties": {
          "jarvis.reminders.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the Reminders sub-feature. Only effective when jarvis.messages.enabled is true. When false, no Reminders tree view or tools are registered."
          }
        }
      },
      {
        "title": "MCP",
        "properties": {
          "jarvis.mcp.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable the embedded MCP server (localhost only). When false, the server does not start."
          },
          "jarvis.mcpPort": {
            "type": "number",
            "default": 31415,
            "description": "Port for the embedded MCP server (localhost only)."
          }
        }
      },
      {
        "title": "PIM",
        "properties": {
          "jarvis.pim.showCategories": {
            "type": "boolean",
            "default": true,
            "description": "Show the Categories view in the Jarvis sidebar."
          }
        }
      },
      {
        "title": "Outlook",
        "properties": {
          "jarvis.outlook.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable Outlook COM integration (Windows + Outlook Classic). When disabled, no Outlook COM calls are made."
          },
          "jarvis.outlook.tasks.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the Outlook Tasks integration. Only effective when jarvis.outlook.enabled is true."
          }
        }
      },
      {
        "title": "Recording",
        "properties": {
          "jarvis.recording.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable the Session Recording feature. When true, Start/Stop Recording buttons appear on Project and Event nodes."
          },
          "jarvis.recording.whisperPath": {
            "type": "string",
            "default": "",
            "description": "Absolute path to the Whisper project folder containing recorder.py and the input/ subfolder."
          }
        }
      },
      {
        "title": "Updates",
        "properties": {
          "jarvis.checkForUpdates": {
            "type": "boolean",
            "default": true,
            "description": "Check for new Jarvis releases on GitHub when the extension activates."
          }
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "jarvis_createSession",
        "displayName": "Create Session",
        "modelDescription": "Creates a new Jarvis session folder with session.yaml and context.md under <workspace>/.jarvis/sessions/<name>/. Idempotent: safe to call if the session already exists. When agent is specified, it must match one of the discoverable user-invocable agents under .github/agents/.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "createSession",
        "icon": "$(add)",
        "tags": ["jarvis"],
        "inputSchema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Session name; used verbatim as the folder name."
            },
            "summary": {
              "type": "string",
              "description": "Optional short description written to session.yaml."
            },
            "agent": {
              "type": "string",
              "description": "Optional VS Code chat-mode name (e.g. 'syspilot.cm'). When set, opening the session activates that agent automatically. Must match a user-invocable agent file in .github/agents/."
            },
            "initialMessage": {
              "type": "string",
              "description": "Optional first message to enqueue in the new session's inbox."
            }
          }
        }
      },
      {
        "name": "jarvis_listSessionEntities",
        "displayName": "List Session Entities",
        "modelDescription": "Lists all Jarvis session entities (lightweight projects) discovered under <workspace>/.jarvis/sessions/. Each entry has name, summary, folder, and agent (empty string when no binding set). Distinct from jarvis_listSessions which lists chat sessions.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "listSessionEntities",
        "icon": "$(folder)",
        "tags": ["jarvis"],
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "jarvis_sendToSession",
        "displayName": "Send Message to Chat Session",
        "modelDescription": "Queues a message for delivery to another VS Code chat session identified by name. The message appears in the Jarvis Messages explorer and can be delivered to the target session. Always set senderSession to your own session name so the receiver knows who sent the message.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sendToSession",
        "icon": "$(comment-discussion)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string",
              "description": "The exact name/title of the destination chat session"
            },
            "senderSession": {
              "type": "string",
              "description": "Your own session/tab name so the receiver knows who sent this message"
            },
            "text": {
              "type": "string",
              "description": "The message text to send to the target session"
            }
          },
          "required": [
            "session",
            "text"
          ]
        }
      },
      {
        "name": "jarvis_listSessions",
        "displayName": "List Chat Sessions",
        "modelDescription": "Returns the list of named chat session titles in the current workspace. Use this to discover valid session names before sending messages via sendToSession.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "listSessions",
        "icon": "$(list-unordered)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "jarvis_listProjects",
        "displayName": "List Projects",
        "modelDescription": "Returns the list of projects configured in the current Jarvis workspace. Each project has a name and folder path.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "listProjects",
        "icon": "$(project)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "jarvis_readMessage",
        "displayName": "Read Message from Inbox",
        "modelDescription": "Reads and removes the oldest message from the Jarvis message queue for the given destination session. Returns the message (sender, text, timestamp) and the count of remaining messages. Call repeatedly until remaining is 0 to read all messages.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "readMessage",
        "icon": "$(mail-read)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "destination": {
              "type": "string",
              "description": "The exact name/title of the destination chat session whose messages to read"
            }
          },
          "required": [
            "destination"
          ]
        }
      },
      {
        "name": "jarvis_registerJob",
        "displayName": "Register Heartbeat Job",
        "modelDescription": "Registers (or updates) a heartbeat job with the given name, cron schedule, and steps. Use this to create recurring automation tasks. Steps can be of type python, powershell, command, agent, or queue.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "registerJob",
        "icon": "$(add)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Unique name for the heartbeat job"
            },
            "schedule": {
              "type": "string",
              "description": "5-field cron expression or 'manual'"
            },
            "steps": {
              "type": "array",
              "description": "Ordered list of steps to execute",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Step type: python, powershell, command, agent, or queue"
                  },
                  "run": {
                    "type": "string",
                    "description": "Script path or VS Code command ID (for python/powershell/command)"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "Path to prompt file (for agent steps)"
                  },
                  "outputFile": {
                    "type": "string",
                    "description": "Path to write LLM response (for agent steps)"
                  },
                  "append": {
                    "type": "boolean",
                    "description": "Append to outputFile instead of overwrite (for agent steps)"
                  },
                  "destination": {
                    "type": "string",
                    "description": "Target chat session name (for queue steps)"
                  },
                  "sender": {
                    "type": "string",
                    "description": "Sender name (for queue steps)"
                  },
                  "text": {
                    "type": "string",
                    "description": "Message content (for queue steps)"
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          },
          "required": [
            "name",
            "schedule",
            "steps"
          ]
        }
      },
      {
        "name": "jarvis_unregisterJob",
        "displayName": "Unregister Heartbeat Job",
        "modelDescription": "Removes a heartbeat job by name. Returns whether the job was found and removed.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "unregisterJob",
        "icon": "$(trash)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The name of the heartbeat job to remove"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "jarvis_listJobs",
        "displayName": "List Heartbeat Jobs",
        "modelDescription": "Returns all registered heartbeat jobs with name, schedule, enabled state, and next scheduled fire time (ISO 8601 or null for manual/paused jobs).",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "listJobs",
        "icon": "$(list-unordered)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "jarvis_setReminder",
        "displayName": "Set Reminder",
        "modelDescription": "Registers a time-scheduled reminder. Delivers a message to the named chat session at deliverAt (ISO 8601). Returns { id, deliverAt }.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "setReminder",
        "icon": "$(bell)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": { "type": "string", "description": "Message to deliver" },
            "session": { "type": "string", "description": "Target chat session name" },
            "deliverAt": { "type": "string", "description": "ISO 8601 delivery timestamp (must be in the future)" }
          },
          "required": ["text", "session", "deliverAt"]
        }
      },
      {
        "name": "jarvis_listReminders",
        "displayName": "List Reminders",
        "modelDescription": "Returns all pending reminders: { reminders: [{ id, text, session, deliverAt, createdAt, remainingMs }] }.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "listReminders",
        "icon": "$(bell)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "jarvis_cancelReminder",
        "displayName": "Cancel Reminder",
        "modelDescription": "Cancels a pending reminder by id. Returns { status: 'cancelled' | 'not_found' }.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "cancelReminder",
        "icon": "$(bell-slash)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "Reminder UUID to cancel" }
          },
          "required": ["id"]
        }
      },
      {
        "name": "jarvis_category",
        "displayName": "Manage Categories",
        "modelDescription": "Manage categories from all configured PIM providers. Actions: get (list/filter categories from cache), set (create/update a category), delete (remove a category), rename (rename a category). When no providers are configured, returns an error.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "category",
        "icon": "$(tag)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["get", "set", "delete", "rename"],
              "description": "The action to perform"
            },
            "name": {
              "type": "string",
              "description": "Category name (required for set/delete)"
            },
            "filter": {
              "type": "string",
              "description": "Filter by name prefix or source (for get)"
            },
            "provider": {
              "type": "string",
              "description": "Target provider (omit to broadcast to all)"
            },
            "oldName": {
              "type": "string",
              "description": "Current category name (required for rename)"
            },
            "newName": {
              "type": "string",
              "description": "New category name (required for rename)"
            }
          },
          "required": ["action"]
        }
      },
      {
        "name": "jarvis_task",
        "displayName": "Manage Tasks",
        "modelDescription": "Manage Outlook tasks linked to Jarvis projects and events. Actions: get (list/filter tasks from cache), set (create a new task), modify (update task fields), delete (remove a task). completedDate is read-only. When no providers are configured, returns an error.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "task",
        "icon": "$(checklist)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["get", "set", "modify", "delete"],
              "description": "The action to perform"
            },
            "category": {
              "type": "string",
              "description": "Filter by category name (for get)"
            },
            "status": {
              "type": "string",
              "description": "Filter by status (for get)"
            },
            "dueBefore": {
              "type": "string",
              "description": "Filter: only tasks due before this ISO date (for get)"
            },
            "includeBody": {
              "type": "boolean",
              "description": "Include task body in get results (default false)"
            },
            "id": {
              "type": "string",
              "description": "Task ID (required for modify/delete)"
            },
            "subject": {
              "type": "string",
              "description": "Task subject"
            },
            "body": {
              "type": "string",
              "description": "Task body text"
            },
            "dueDate": {
              "type": "string",
              "description": "Due date (ISO YYYY-MM-DD)"
            },
            "priority": {
              "type": "string",
              "enum": ["low", "normal", "high"],
              "description": "Task priority"
            },
            "isComplete": {
              "type": "boolean",
              "description": "Mark task as complete (sets completedDate as side effect)"
            },
            "categories": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Outlook category names linking task to projects/events"
            },
            "provider": {
              "type": "string",
              "description": "Target provider (omit to broadcast to all)"
            }
          },
          "required": ["action"]
        }
      }
    ]
  },
