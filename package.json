{
  "name": "jarvis",
  "displayName": "Jarvis",
  "description": "Personal assistant for managing projects and events in VS Code",
  "version": "0.12.0",
  "publisher": "enthali",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/enthali/Jarvis.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "scripts": {
    "compile": "tsc -p packages/core",
    "compile:packages": "npm run compile --workspaces --if-present",
    "build": "npm run compile:packages",
    "typecheck:parked": "tsc -p tsconfig.parked.json --noEmit",
    "watch": "tsc -watch -p packages/core",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "package": "cd packages/core && npx vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cron-parser": "^5.5.0",
    "js-yaml": "^4.1.1",
    "sql.js": "^1.14.1"
  }
}
