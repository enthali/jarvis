// Implementation: SPEC_DEV_LAUNCHCONFIG
// Requirements: REQ_DEV_LAUNCHCONFIG
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "compile",
            "group": "build",
            "label": "npm: compile",
            "problemMatcher": "$tsc"
        },
        {
            "type": "npm",
            "script": "watch",
            "group": "build",
            "label": "npm: watch",
            "isBackground": true,
            "problemMatcher": "$tsc-watch"
        },
        {
            "type": "shell",
            "command": "npx tsc -p packages/core",
            "group": "build",
            "label": "compile core",
            "problemMatcher": "$tsc"
        },
        {
            "type": "shell",
            "command": "npx tsc -p packages/core && npx tsc -p packages/pim",
            "group": "build",
            "label": "compile core+pim",
            "problemMatcher": "$tsc"
        },
        {
            "type": "shell",
            "command": "npx tsc -p packages/core && npx tsc -p packages/pim && npx tsc -p packages/recorder",
            "group": "build",
            "label": "compile core+pim+recorder",
            "problemMatcher": "$tsc"
        },
        {
            "type": "shell",
            "command": "npx tsc -p packages/core && npx tsc -p packages/pim && npx tsc -p packages/recorder && npx tsc -p packages/mcp",
            "group": "build",
            "label": "compile all",
            "problemMatcher": "$tsc"
        }
    ]
}
